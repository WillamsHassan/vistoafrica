{
  "name": "vistoafrica-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "prebuild": "prisma generate --schema prisma/schema.prisma",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:test": "tsx src/scripts/test-mongodb-connection.ts",
    "test:database-connections": "tsx src/scripts/test-database-connections.ts",
    "migrate:postgres-to-mongodb": "tsx src/scripts/migrate-postgres-to-mongodb.ts",
    "verify:postgres-to-mongodb": "tsx src/scripts/verify-postgres-to-mongodb.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "analytics:purge": "tsx src/scripts/purge-analytics.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.7.0",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.18.0",
    "puppeteer": "^25.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
