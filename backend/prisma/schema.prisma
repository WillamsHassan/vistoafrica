generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

enum RegistrationStatus {
  PENDING
  PAYMENT_PENDING
  PAYMENT_DECLARED
  PAYMENT_VERIFIED
  CONFIRMED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  MTN
  ORANGE
}

enum PaymentStatus {
  PENDING
  DECLARED
  VERIFIED
  REJECTED
}

enum PaymentActionType {
  VERIFIED
  REJECTED
}

enum AnalyticsEventType {
  PAGE_VIEW
  COURSE_VIEW
  REGISTRATION_STARTED
  REGISTRATION_COMPLETED
  PAYMENT_STARTED
  PAYMENT_DECLARED
}

model Admin {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  legacyId      String?        @unique
  fullName      String
  email         String         @unique
  passwordHash  String
  role          String         @default("ADMIN")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  payments      Payment[]      @relation("AdminPayments")
  paymentActions PaymentAction[]
  auditLogs     AdminAuditLog[]
}

model Student {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  legacyId      String?       @unique
  firstName     String
  lastName      String
  email         String        @unique
  phone         String?
  city          String?
  passwordHash  String?
  deletedAt     DateTime?
  archivedEmail String?
  relationGuard Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  registrations Registration[]
}

model Course {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  legacyId        String?       @unique
  slug            String        @unique
  name            String
  category        String        @default("Général")
  type            String        @default("Formation")
  description     String
  duration        String?
  frequency       String?
  sessionDuration String?
  price           Float
  registrationFee Float
  hourlyRate      Float?
  examIncluded    Boolean       @default(false)
  manualIncluded  Boolean       @default(false)
  preparationFees Float?
  installments    Json?
  image           String?
  isActive        Boolean       @default(true)
  archivedAt      DateTime?
  archivedWasActive Boolean?
  relationGuard   Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  registrations   Registration[]
}

model Registration {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  legacyId       String?           @unique
  legacyStudentId String?
  legacyCourseId  String?
  accessToken    String?           @unique
  studentId      String            @db.ObjectId
  courseId       String            @db.ObjectId
  status         RegistrationStatus @default(PAYMENT_PENDING)
  amount         Float
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  student        Student           @relation(fields: [studentId], references: [id])
  course         Course            @relation(fields: [courseId], references: [id])
  payments       Payment[]
  invoice        Invoice?
}

model Payment {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  legacyId          String?       @unique
  legacyRegistrationId String?
  legacyAdminId     String?
  registrationId    String        @db.ObjectId
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  archivedAt        DateTime?
  amount            Float
  reference         String?
  accountName       String?
  proofUrl          String?
  declaredAt        DateTime      @default(now())
  verifiedAt        DateTime?
  adminId           String?       @db.ObjectId
  reviewedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  registration      Registration @relation(fields: [registrationId], references: [id])
  admin             Admin?       @relation("AdminPayments", fields: [adminId], references: [id])
  actions           PaymentAction[]
  invoice           Invoice?
}

model PaymentAction {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  legacyId  String?           @unique
  paymentId String            @db.ObjectId
  adminId   String            @db.ObjectId
  action    PaymentActionType
  comment   String?
  createdAt DateTime          @default(now())

  payment   Payment @relation(fields: [paymentId], references: [id])
  admin     Admin   @relation(fields: [adminId], references: [id])

  @@index([paymentId, createdAt])
}

model Invoice {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  legacyId           String?     @unique
  legacyRegistrationId String?
  legacyPaymentId     String?
  registrationId     String      @db.ObjectId @unique
  paymentId          String      @db.ObjectId @unique
  invoiceNumber      String      @unique
  total              Float
  storageKey         String      @unique
  generatedAt        DateTime?
  issuedAt           DateTime    @default(now())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  registration       Registration @relation(fields: [registrationId], references: [id])
  payment            Payment      @relation(fields: [paymentId], references: [id])
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  legacyId  String?  @unique
  name      String
  email     String
  phone     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  legacyId    String?  @unique
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model VisitorSession {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  legacyId        String?          @unique
  visitorId       String           @unique
  firstSeenAt     DateTime         @default(now())
  lastSeenAt      DateTime         @default(now())
  duration        Int              @default(0)
  pageViews       Int              @default(0)
  entryPage       String
  lastPage        String
  referrer        String?
  deviceType      String?
  browser         String?
  operatingSystem String?
  language        String?
  resolution      String?
  country         String?
  city            String?
  isRegistered    Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  pageViewRecords PageView[]
  analyticsEvents AnalyticsEvent[]

  @@index([lastSeenAt])
  @@index([createdAt])
}

model PageView {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  legacyId         String?        @unique
  visitorSessionId String         @db.ObjectId
  path             String
  title            String?
  timestamp        DateTime       @default(now())
  duration         Int            @default(0)
  visitorSession   VisitorSession @relation(fields: [visitorSessionId], references: [id], onDelete: Cascade)

  @@index([visitorSessionId, timestamp])
  @@index([path, timestamp])
}

model AnalyticsEvent {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  legacyId         String?           @unique
  visitorSessionId String            @db.ObjectId
  type             AnalyticsEventType
  path             String
  metadata         Json?
  createdAt        DateTime          @default(now())
  visitorSession   VisitorSession    @relation(fields: [visitorSessionId], references: [id], onDelete: Cascade)

  @@index([visitorSessionId, createdAt])
  @@index([type, createdAt])
}

model AdminAuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId     String   @db.ObjectId
  action      String
  entityType  String
  entityId    String
  description String?
  createdAt   DateTime @default(now())
  admin       Admin    @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@index([entityType, entityId, createdAt])
}
